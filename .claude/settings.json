{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch)",
      "Bash(git fetch origin:*)",
      "Bash(git fetch -q:*)",
      "Bash(git fetch --prune:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(git rebase origin/main)",
      "Bash(git rebase --continue)",
      "Bash(git rebase --abort)",
      "Bash(git worktree:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-files:*)",
      "Bash(git grep:*)",
      "Bash(git stash list:*)",
      "Bash(git push:*)",
      "Bash(make ci:*)",
      "Bash(make test:*)",
      "Bash(make lint:*)",
      "Bash(make build:*)",
      "Bash(make e2e:*)",
      "Bash(make vuln:*)",
      "Bash(make image:*)",
      "Bash(make image-smoke:*)",
      "Bash(make image-scan:*)",
      "Bash(make perf:*)",
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go list:*)",
      "Bash(go mod:*)",
      "Bash(golangci-lint:*)",
      "Bash(npm ci:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx playwright:*)",
      "Bash(scripts/adr-immutable.sh:*)",
      "Bash(scripts/check-file-size.sh:*)",
      "Bash(scripts/fuzz.sh:*)",
      "Bash(scripts/image-scan.sh:*)",
      "Bash(scripts/image-smoke.sh:*)",
      "Bash(scripts/image-smoke-adopt.sh:*)",
      "Bash(scripts/pre-commit-adr_test.sh:*)",
      "Bash(scripts/release-meta_test.sh:*)",
      "Bash(scripts/verify-release-tag_test.sh:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)",
      "Bash(gh run rerun:*)"
    ],
    "ask": [
      "Edit(**/.claude/hooks/**)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.githooks/**)",
      "Edit(**/.gitleaks.toml)",
      "Edit(**/.github/workflows/**)",
      "Edit(**/LICENSE)",
      "Edit(**/.git/**)",
      "Write(**/.git/**)",
      "Edit(**/.git)",
      "Write(**/.git)"
    ],
    "deny": [
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(export -p)",
      "Bash(set)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/hosts.yml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/postelmd_guard.py\" secrets",
            "timeout": 10,
            "statusMessage": "Scanning for secret-shaped strings…"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/postelmd_guard.py\" public",
            "timeout": 10,
            "statusMessage": "Checking content is safe to publish…"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/postelmd_guard.py\" adr",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/postelmd_guard.py\" git",
            "timeout": 10,
            "statusMessage": "Checking git/GitHub command policy…"
          }
        ]
      }
    ]
  }
}
