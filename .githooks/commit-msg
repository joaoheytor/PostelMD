#!/bin/sh
# commit-msg: Conventional Commit subject + DCO sign-off matching the author (CONTRIBUTING.md).
# Enable once per clone:  git config core.hooksPath .githooks
# CI enforces the same rules (pr-title, DCO); this only fails earlier.
msg_file="$1"
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT INT TERM
# Normalize: drop CR, stop at the scissors line (commit -v), drop comment lines.
tr -d '\r' < "$msg_file" | sed '/^# -\{8,\} >8 -\{8,\}$/,$d' | grep -v '^#' > "$tmp" || true
subject=$(sed -n '/./{p;q;}' "$tmp")

# Git-generated subjects skip the format check, but never the sign-off check.
case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) ;;
  *)
    if ! printf '%s\n' "$subject" | grep -qE '^(feat|fix|perf|refactor|docs|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: [^ ]'; then
      echo "commit-msg: subject is not a Conventional Commit:" >&2
      echo "  $subject" >&2
      echo "  expected e.g. 'docs(adr): clarify save protocol' (types: feat fix perf refactor docs test build ci chore revert)" >&2
      exit 1
    fi
    if [ "$(printf '%s' "$subject" | LC_ALL=C.UTF-8 wc -m)" -gt 100 ]; then
      echo "commit-msg: subject is longer than 100 characters." >&2
      exit 1
    fi
    ;;
esac

# DCO: a Signed-off-by line for the commit's author.
author=$(git var GIT_AUTHOR_IDENT | sed 's/ [0-9]* [-+][0-9]*$//')
if ! grep -qxF "Signed-off-by: $author" "$tmp"; then
  echo "commit-msg: missing DCO sign-off for the author ($author). Use the -s flag when committing." >&2
  exit 1
fi
