{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommitTypeAll(build)",
    ":semanticCommitScope(deps)"
  ],
  "commitBody": "Signed-off-by: renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>",
  "labels": ["dependencies", "skip-changelog"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Patch and digest updates merge automatically once the required checks pass.",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Minor and major updates always get a human review.",
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    },
    {
      "description": "modernc.org/sqlite: two weeks old at least, as ADR-0015 picks versions, and a human review. Its go get brings exactly the modernc.org/libc it requires.",
      "matchPackageNames": ["modernc.org/sqlite"],
      "minimumReleaseAge": "14 days",
      "automerge": false
    },
    {
      "description": "modernc.org/libc moves only with modernc.org/sqlite, to the version sqlite's go.mod names (ADR-0015; scripts/check-sqlite-libc.sh).",
      "matchPackageNames": ["modernc.org/libc"],
      "enabled": false
    }
  ]
}
