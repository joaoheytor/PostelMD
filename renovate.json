{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommitTypeAll(build)",
    ":semanticCommitScope(deps)"
  ],
  "commitBody": "Signed-off-by: renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>",
  "labels": ["dependencies", "skip-changelog"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Patch and digest updates merge automatically once the required checks pass.",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Minor and major updates always get a human review.",
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    },
    {
      "description": "modernc.org/sqlite needs modernc.org/libc at exactly the version its go.mod names: one PR bumps both, with a human review (ADR-0015).",
      "matchPackageNames": ["modernc.org/sqlite", "modernc.org/libc"],
      "groupName": "modernc.org/sqlite and libc",
      "automerge": false
    }
  ]
}
